{
  "items": [
    {
      "id": "gn3b027",
      "kind": "grammar",
      "level": "N3",
      "text": "动词加直す：重新做、改做一次",
      "reading": "直す、直した、直している",
      "romaji": "naosu naoshita naoshite iru",
      "meaning": "把重新实施与修好、做完、做对分开",
      "explanation": "动词ます形词干加直す，表示重新做、再次做，常为修改、确认或调整，但不必以原先做错为前提，也不保证重做后一定成功。読み直す是再读，書き直す是重写，考え直す是重新考虑；不要把每一种直す都理解成修理物品或治好疾病。读清时态，计划重做、正在重做与已经重做是不同状态。",
      "sourceIDs": [
        "openjlpt",
        "projectopen",
        "jmdict",
        "ninjalcomp"
      ],
      "status": "trial",
      "prerequisiteIDs": [
        "gn419",
        "gn3b023"
      ],
      "citations": [
